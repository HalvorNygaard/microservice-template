<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoBuild>true</NoBuild>
    <IncludeContentInPack>true</IncludeContentInPack>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageType>Template</PackageType>
    <PackageId>ModernMicroservice.Template</PackageId>
    <Version>1.0.1</Version>
    <Authors>Modern Microservice Template Contributors</Authors>
    <Description>A PostgreSQL vertical-slice reference service built with modern .NET and Aspire.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>dotnet;aspire;microservice;minimal-api;template</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Content
      Include="..\.editorconfig;..\.gitattributes;..\.gitignore;..\Directory.Build.props;..\Directory.Packages.props;..\LICENSE;..\MicroserviceTemplate.slnx;..\NuGet.Config;..\aspire.config.json;..\global.json"
      Pack="true"
      PackagePath="content" />
    <Content
      Include="..\.config\**\*"
      Pack="true"
      PackagePath="content/.config/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content
      Include="..\docs\architecture.md;..\docs\greenfield.md;..\docs\operations.md"
      Pack="true"
      PackagePath="content/docs/%(Filename)%(Extension)" />
    <Content
      Include="..\src\**\*"
      Exclude="..\src\**\bin\**;..\src\**\obj\**;..\src\**\TestResults\**;..\src\**\*.user;..\src\**\*.suo;..\src\**\*.nupkg;..\src\**\*.snupkg;..\src\**\*.pfx;..\src\**\*.p12;..\src\**\*.pem;..\src\**\*.key;..\src\**\*.crt;..\src\**\*.cer;..\src\**\*.der;..\src\**\*.snk;..\src\**\.env;..\src\**\.env.*;..\src\**\id_rsa*;..\src\**\nul"
      Pack="true"
      PackagePath="content/src/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content
      Include="..\tests\MicroserviceTemplate.UnitTests\**\*"
      Exclude="..\tests\MicroserviceTemplate.UnitTests\**\bin\**;..\tests\MicroserviceTemplate.UnitTests\**\obj\**;..\tests\MicroserviceTemplate.UnitTests\**\TestResults\**;..\tests\MicroserviceTemplate.UnitTests\**\*.user;..\tests\MicroserviceTemplate.UnitTests\**\*.suo;..\tests\MicroserviceTemplate.UnitTests\**\*.pfx;..\tests\MicroserviceTemplate.UnitTests\**\*.p12;..\tests\MicroserviceTemplate.UnitTests\**\*.pem;..\tests\MicroserviceTemplate.UnitTests\**\*.key;..\tests\MicroserviceTemplate.UnitTests\**\*.crt;..\tests\MicroserviceTemplate.UnitTests\**\*.cer;..\tests\MicroserviceTemplate.UnitTests\**\*.der;..\tests\MicroserviceTemplate.UnitTests\**\*.snk;..\tests\MicroserviceTemplate.UnitTests\**\.env;..\tests\MicroserviceTemplate.UnitTests\**\.env.*;..\tests\MicroserviceTemplate.UnitTests\**\id_rsa*;..\tests\MicroserviceTemplate.UnitTests\**\nul"
      Pack="true"
      PackagePath="content/tests/MicroserviceTemplate.UnitTests/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content
      Include="..\tests\MicroserviceTemplate.IntegrationTests\**\*"
      Exclude="..\tests\MicroserviceTemplate.IntegrationTests\**\bin\**;..\tests\MicroserviceTemplate.IntegrationTests\**\obj\**;..\tests\MicroserviceTemplate.IntegrationTests\**\TestResults\**;..\tests\MicroserviceTemplate.IntegrationTests\**\*.user;..\tests\MicroserviceTemplate.IntegrationTests\**\*.suo;..\tests\MicroserviceTemplate.IntegrationTests\**\*.pfx;..\tests\MicroserviceTemplate.IntegrationTests\**\*.p12;..\tests\MicroserviceTemplate.IntegrationTests\**\*.pem;..\tests\MicroserviceTemplate.IntegrationTests\**\*.key;..\tests\MicroserviceTemplate.IntegrationTests\**\*.crt;..\tests\MicroserviceTemplate.IntegrationTests\**\*.cer;..\tests\MicroserviceTemplate.IntegrationTests\**\*.der;..\tests\MicroserviceTemplate.IntegrationTests\**\*.snk;..\tests\MicroserviceTemplate.IntegrationTests\**\.env;..\tests\MicroserviceTemplate.IntegrationTests\**\.env.*;..\tests\MicroserviceTemplate.IntegrationTests\**\id_rsa*;..\tests\MicroserviceTemplate.IntegrationTests\**\nul"
      Pack="true"
      PackagePath="content/tests/MicroserviceTemplate.IntegrationTests/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="README.template.md" Pack="true" PackagePath="content/README.md" />
    <Content Include="ci.generated.yml" Pack="true" PackagePath="content/.github/workflows/ci.yml" />
    <Content Include="AGENTS.template.md" Pack="true" PackagePath="content/AGENTS.md" />
  </ItemGroup>

  <ItemGroup>
    <Content Include=".template.config\**" Pack="true" PackagePath="content\.template.config" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>

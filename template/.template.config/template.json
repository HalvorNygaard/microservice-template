{
  "$schema": "http://json.schemastore.org/template",
  "author": "Modern Microservice Template Contributors",
  "classifications": ["Web", "ASP.NET", "Microservice", "Aspire", "Minimal API", "Vertical Slice"],
  "identity": "ModernMicroservice.Template",
  "name": "Modern Microservice",
  "shortName": "modern-microservice",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "preferNameDirectory": true,
  "sources": [
    {
      "source": "./",
      "target": "./",
      "include": [
        "**/*"
      ],
      "exclude": [
        ".template.config/**/*"
      ]
    }
  ],
  "symbols": {
    "ServiceNameInPaths": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "RawName",
      "replaces": "MicroserviceTemplate",
      "fileRename": "MicroserviceTemplate"
    },
    "ServiceNameKebab": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "ServiceNameToKebab",
      "replaces": "apiservice"
    },
    "ServiceNamespace": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "ServiceNameToNamespace",
      "replaces": "ModernMicroservice"
    },
    "skipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "description": "If specified, skips the automatic restore of the project on create.",
      "defaultValue": "false"
    },
    "ApiHttpPort": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "fallback": "5471"
      },
      "replaces": "5471"
    },
    "AppHostHttpPort": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "fallback": "15183"
      },
      "replaces": "15183"
    },
    "DashboardOtlpPort": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "fallback": "19100"
      },
      "replaces": "19100"
    },
    "ResourceServicePort": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "fallback": "20100"
      },
      "replaces": "20100"
    }
  },
  "forms": {
    "RawName": {
      "identifier": "replace",
      "pattern": "$^",
      "replacement": ""
    },
    "ServiceNameToKebab": {
      "identifier": "chain",
      "steps": [
        "ReplaceSeparatorsWithHyphen",
        "InsertHyphen",
        "ToLowerInvariant"
      ]
    },
    "ServiceNameToNamespace": {
      "identifier": "chain",
      "steps": [
        "ProtectNamespaceDots",
        "ToKebabCase",
        "ToTitleCase",
        "RestoreNamespaceDots",
        "RemoveNamespaceSeparators",
        "PrefixNumericNamespaceSegments"
      ]
    },
    "ProtectNamespaceDots": {
      "identifier": "replace",
      "pattern": "\\.",
      "replacement": "-namespace-dot-"
    },
    "ToKebabCase": {
      "identifier": "kebabCase"
    },
    "ToTitleCase": {
      "identifier": "titleCase"
    },
    "RestoreNamespaceDots": {
      "identifier": "replace",
      "pattern": "-Namespace-Dot-",
      "replacement": "."
    },
    "RemoveNamespaceSeparators": {
      "identifier": "replace",
      "pattern": "[-_\\s]+",
      "replacement": ""
    },
    "PrefixNumericNamespaceSegments": {
      "identifier": "replace",
      "pattern": "(^|\\.)([0-9])",
      "replacement": "${1}Service${2}"
    },
    "ReplaceSeparatorsWithHyphen": {
      "identifier": "replace",
      "pattern": "[\\._]",
      "replacement": "-"
    },
    "InsertHyphen": {
      "identifier": "replace",
      "pattern": "([a-z])([A-Z])",
      "replacement": "$1-$2"
    },
    "ToLowerInvariant": {
      "identifier": "lowerCaseInvariant"
    }
  },
  "postActions": [
    {
      "condition": "(!skipRestore)",
      "description": "Restore NuGet packages",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
